# Copy this file to .env.local (gitignored) and fill in real values.
# The same two variables must also be added in Vercel's Project Settings ->
# Environment Variables, then redeploy — .env.local only applies locally.

# Webhook that receives every "Get Free Quote" submission — the header/CTA
# button modal, and the hero/sidebar forms on category, service, city, and
# home pages (all use the same QuoteForm component).
NEXT_PUBLIC_QUOTE_WEBHOOK_URL=

# Webhook that receives "Call Me" callback requests (the floating button
# bottom-right on every page).
NEXT_PUBLIC_CALLBACK_WEBHOOK_URL=
